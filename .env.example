# Shared by backend/cloud Compose: docker compose --env-file ../.env ...
# Google OAuth WEB client. Set the exact HTTPS callback in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/youtube/oauth/callback
# Generate 32 random bytes as hex; preserve this key to decrypt saved tokens.
YOUTUBE_TOKEN_KEY=
# Generate a separate random secret (at least 32 characters), same for both services.
WORKER_API_SECRET=
BACKEND_INTERNAL_URL=http://api:4000
